# Production Environment Variables
# Copy this file to .env and fill in the values

# APP Settings
APP_ENV=production
PORT=3000

# Security
COOKIE_SECRET=change_this_generate_new_secure_random_string
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change_this_to_strong_password

# Database (PostgreSQL)
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=vendure
DB_USERNAME=vendure
DB_PASSWORD=change_me_strong_password

# Assets
ASSET_URL_PREFIX=http://localhost:3000/assets/